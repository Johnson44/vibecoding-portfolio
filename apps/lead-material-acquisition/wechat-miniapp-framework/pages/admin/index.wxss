.admin-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 46rpx 28rpx 64rpx;
  background: #f4f0e8;
  color: #111111;
}

.admin-header { margin-bottom: 34rpx; }
.eyebrow { display: block; margin-bottom: 14rpx; color: #f04438; font-size: 22rpx; font-weight: 900; letter-spacing: 3rpx; }
.admin-title { display: block; font-size: 48rpx; font-weight: 900; letter-spacing: -2rpx; }
.admin-subtitle { display: block; margin-top: 12rpx; color: #6c685f; font-size: 24rpx; line-height: 1.6; }
.admin-list { display: grid; gap: 20rpx; }
.upload-card { display: grid; grid-template-columns: 1fr 160rpx; gap: 22rpx; align-items: center; padding: 24rpx; border: 2rpx solid #111111; background: #ffffff; box-shadow: 7rpx 7rpx 0 #111111; }
.upload-copy { align-self: start; }
.upload-title, .upload-ratio { display: block; }
.upload-title { font-size: 29rpx; font-weight: 900; }
.upload-ratio { margin-top: 8rpx; color: #77736b; font-size: 22rpx; }
.upload-preview { grid-column: 2; grid-row: 1 / span 2; width: 160rpx; height: 200rpx; display: flex; align-items: center; justify-content: center; box-sizing: border-box; overflow: hidden; border: 2rpx dashed #88837a; background: #f7f7f7; }
.upload-preview-square { height: 160rpx; aspect-ratio: 1 / 1; border-style: solid; }
.upload-image { width: 100%; height: 100%; }
.upload-empty { color: #999999; font-size: 26rpx; }
.upload-actions { display: flex; align-items: center; gap: 16rpx; }
.outline-button, .text-button, .primary-button, .secondary-button { box-sizing: border-box; font-size: 24rpx; }
.outline-button { width: 176rpx; padding: 14rpx 0; border: 2rpx solid #111111; background: #ffbf00; color: #111111; }
.text-button { width: 90rpx; padding: 14rpx 0; background: transparent; color: #f04438; }
.admin-message { margin-top: 28rpx; padding: 18rpx 20rpx; border-left: 6rpx solid #f04438; background: #fff2ed; color: #68443d; font-size: 23rpx; line-height: 1.55; }
.admin-actions { display: grid; gap: 16rpx; margin-top: 34rpx; }
.primary-button, .secondary-button { width: 100%; padding: 18rpx 0; border: 2rpx solid #111111; font-weight: 900; }
.primary-button { background: #111111; color: #ffffff; }
.secondary-button { background: #ffffff; color: #111111; }
.admin-footnote { margin-top: 34rpx; color: #77736b; font-size: 21rpx; line-height: 1.6; text-align: center; }
